{
	admin off
	auto_https off
}

:8080 {
	request_body {
		max_size 10MB
	}
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	@private path /.env* /.git* /artifacts/* /infrastructure/* /backend_fastapi/* /tools/*
	handle @private {
		respond 404
	}

	handle /api/v1/* {
		reverse_proxy demo-api:3000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control no-cache
		file_server
	}
}
